# Public site URL used for Open Graph / social preview metadata
NEXT_PUBLIC_SITE_URL=https://zouruhotel.com

# Optional: receive POST JSON payloads for every booking request (Slack, Zapier, Make, CRM)
# BOOKING_WEBHOOK_URL=

# Optional: send booking notification emails via Resend (https://resend.com)
# RESEND_API_KEY=
# BOOKING_NOTIFY_EMAIL=reservations@zouruhotel.com
# BOOKING_FROM_EMAIL="Zouru Hotel <bookings@zouruhotel.com>"
